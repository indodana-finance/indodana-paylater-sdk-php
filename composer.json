{
  "name": "indodana/indodana-paylater-sdk",
  "description": "Indodana Paylater SDK for PHP that provides merchant integration functionalities",
  "authors": [
    {
      "name": "Indodana",
      "email": "dev@indodana.com"
    },
    {
      "name": "Steven Yang",
      "email": "syang@indodana.com"
    }
  ],
  "autoload": {
    "psr-4": {
      "Indodana\\":"src/"
    }
  },
  "scripts": {
    "sniffer:php8": "phpcs -p ./src --standard=vendor/phpcompatibility/php-compatibility/PHPCompatibility --runtime-set testVersion 8.3-",
    "test": "./vendor/bin/phpunit --configuration phpunit.xml.dist --testdox --no-coverage",
    "test:coverage": "./vendor/bin/phpunit --configuration phpunit.xml.dist --testdox"
  },
  "require": {
    "php": "^8.3"
  },
  "require-dev": {
    "phpunit/phpunit": "^11.0",
    "mockery/mockery": "^1.6",
    "php-mock/php-mock-mockery": "^1.4",
    "squizlabs/php_codesniffer": "^3.10",
    "phpcompatibility/php-compatibility": "^10.0@alpha"
  },
  "config": {
    "platform": {
      "php": "8.3"
    },
    "allow-plugins": {
      "dealerdirect/phpcodesniffer-composer-installer": true
    }
  }
}
